# Database Configuration (Use SQLite for zero-setup local dev or PostgreSQL)
DATABASE_URL=sqlite:///./skinsafe.db
# For PostgreSQL in Docker / Prod:
# DATABASE_URL=postgresql://skinsafe_user:skinsafe_secret@localhost:5432/skinsafe_db

# Security & JWT Auth
JWT_SECRET_KEY=supersecretjwtkey_change_in_production_skinsafe2026_sensitive_skin_analyzer
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# AI Configuration (Optional: built-in intelligent fallback runs if empty)
AI_PROVIDER=gemini
AI_API_KEY=
OPENAI_API_KEY=

# CORS Configuration (comma-separated origins or *)
CORS_ORIGINS=*
